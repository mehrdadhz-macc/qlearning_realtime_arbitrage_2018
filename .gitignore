# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
.venv/
*.egg-info/
dist/
build/

# macOS
.DS_Store

# Claude Code local settings
.claude/

# Data IS tracked (raw workbooks + cleaned CSV + train/test splits) --
# ~21MB total, small enough to check in directly rather than requiring every
# clone to re-run the download/preprocess/split pipeline. See data/raw/DATA_SOURCE.txt.

# Logs
outputs/logs/

# Generated outputs: each run is fully self-contained under outputs/runs/
# <timestamp>/ (q_table_*.npy, price_bin_edges_*.npy, history_*.npy,
# summary.json, eval_summary.json, eval_plot.png). outputs/data_plots/ is the
# one exception -- raw price-series plots aren't tied to any specific run.
outputs/runs/*
!outputs/runs/.gitkeep
outputs/data_plots/*
!outputs/data_plots/.gitkeep
